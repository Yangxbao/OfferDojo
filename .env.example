# ==========================================================
# JobSim AI 环境变量模板
# 用法：复制本文件为 .env，填入真实值后再启动。
# .env 已被 .gitignore 忽略，任何真实密钥都不允许提交到仓库。
# ==========================================================

# ---------- 数据库（MySQL 模式，docker-compose 也会读取） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jobsim
MYSQL_USERNAME=jobsim
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ---------- JWT（生产环境必须替换为随机长字符串，长度 >= 32） ----------
JWT_SECRET=please_replace_with_a_random_secret_at_least_32_chars
JWT_TTL_HOURS=72

# ---------- AI 服务（可选；不配置时系统使用内置 MockAIProvider 演示） ----------
# provider 可选值：mock（默认，本地模拟评分） / remote（调用 OpenAI 兼容接口）
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# ---------- 应用 ----------
SERVER_PORT=8090
